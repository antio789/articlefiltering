    },
    {
      "id": 5,
      "description": "Enzyme-only pretreatment control: Napier grass or silage was treated solely with Cellic® CTec2 enzyme at 20 FPU/g-substrate in citrate buffer (pH 5.0) at 50 °C for 72 h, without prior organosolv or hydrothermal treatment."
    },
    {
      "id": 6,
      "description": "Untreated substrate control: Napier grass or silage subjected only to mechanical size reduction and ensiling, with no additional chemical, thermal, or enzymatic treatments applied prior to anaerobic digestion."
    }
  ]
}
