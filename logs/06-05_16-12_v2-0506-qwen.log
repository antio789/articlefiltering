2026-06-05 16:13:05,769 {
  "pretreatments": [
    {
      "id": 0,
      "description": "Thermal pretreatment: Substrate was subjected to heating in an oven at five different temperatures (60, 80, 100, 120, and 140 °C) for varying durations. The specific conditions included 1 hour at 60 °C and 80 °C, 30 minutes at 100 °C, 120 °C, and 140 °C. This process involves breaking down insoluble polymers and decomposing the cytomembrane of the substrate to enhance solubilization."
    },
    {
      "id": 1,
      "description": "Biological pre-hydrolysis (BPH): Substrate was placed in glass vessels flushed with nitrogen, then incubated at two different temperatures (37 °C and 55 °C) for a total duration of 40 hours. The incubation schedule alternated between 20 hours at 37 °C and 20 hours at 55 °C. This process involves extracellular depolymerization of macromolecules (proteins, lipids, polysaccharides) by acidogenic bacteria into oligomers and monomers, followed by inoculation with a 1:10 substrate to inoculum mixture."
    },
    {
      "id": 2,
      "description": "Sample storage: The food waste was collected daily from the kitchen, mixed with a kitchen blender to reduce particle size, and stored in the fridge at 4 °C. This mechanical action reduced the particle size and stored the substrate at 4 °C for maximum 3 weeks prior to any pretreatment or anaerobic digestion testing."
    },
    {
      "id": 3,
      "description": "Combined thermal-biological treatment: This entry represents the integration of the thermal pre-treatment and biological pre-hydrolysis methods as distinct entries for the purpose of classification, as per the instruction to consider combined pretreatment as different entries."
    }
  ]
}
